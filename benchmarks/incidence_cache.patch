+    fn updated_incidence(
+        &self,
+        parents: &[Option<usize>],
+        owners: &BTreeMap<GaussianFactorId, Option<usize>>,
+        changed: &BTreeSet<GaussianFactorId>,
+    ) -> Result<Arc<Incidence>, Error> {
+        let n = self.dimension();
