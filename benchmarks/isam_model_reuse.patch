+    fn into_sparse(self) -> Result<(DVector<f64>, CsrMatrix), Error> {
+        let j = match self.jacobian {
+            Jacobian::Sparse(j) => j,
+            Jacobian::Dense(j) => CsrMatrix::from_triplets(
+                j.nrows(),
+                j.ncols(),
+                (0..j.nrows())
+                    .flat_map(|r| {
+                        let j = &j;
+                        (0..j.ncols())
+                            .filter_map(move |c| (j[(r, c)] != 0.).then_some((r, c, j[(r, c)])))
+                    })
+                    .collect(),
+            )?,
+        };
+        Ok((self.residual, j))
+    }
