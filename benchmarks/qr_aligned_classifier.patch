+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS: [AtomicU64;8]=[const {AtomicU64::new(0)};8];
+pub fn record(values:[u64;8]) { for (c,v) in COUNTS.iter().zip(values) { c.fetch_add(v,Ordering::Relaxed); } }
+pub fn reset() { for c in &COUNTS { c.store(0,Ordering::Relaxed); } }
+pub fn dump() { for (name,c) in ["rotations","empty_upper","prefix_pairs","prefix_upper_only","in_place","fallback","aligned_suffix","aligned_entries"].iter().zip(&COUNTS) { eprintln!("{name},{}",c.load(Ordering::Relaxed)); } }
