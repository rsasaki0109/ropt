+use std::sync::atomic::{AtomicU64, Ordering};
+static TIME: [AtomicU64; 7] = [const {AtomicU64::new(0)}; 7];
+static CALLS: [AtomicU64; 7] = [const {AtomicU64::new(0)}; 7];
+pub struct Scope { id: usize, start: std::time::Instant }
+pub fn begin(id:usize) -> Scope { Scope { id, start:std::time::Instant::now() } }
+impl Drop for Scope {fn drop(&mut self) {TIME[self.id].fetch_add(self.start.elapsed().as_nanos() as u64, Ordering::Relaxed);CALLS[self.id].fetch_add(1,Ordering::Relaxed);}}
+pub fn dump() {for (id,name) in ["build_graph","batch_solve","factor_evaluation","qr_append","graph_retract","ldl_solve","ldl_prepare"].iter().enumerate() {eprintln!("{name}: calls={} inclusive_ns={}",CALLS[id].load(Ordering::Relaxed),TIME[id].load(Ordering::Relaxed));}}
