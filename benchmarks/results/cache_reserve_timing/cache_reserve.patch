 mod capture_tests {
     use super::*;
 
+    #[test]
+    fn append_candidate_retains_policy_and_leaves_committed_rows_unchanged() {
+        let j = CsrMatrix::from_triplets(2, 2, vec![(0, 0, 1.), (1, 1, 2.)]).unwrap();
+        let r = DVector::from_vec(vec![1., -2.]);
+        let factors = recipes(&[1, 1]);
+        let mut original = FactorCache::new(3);
+        original.reset(&j, &r, &factors, 8).unwrap();
+        assert!(matches!(
+            original.clone_for_append(usize::MAX),
+            Err(Error::InvalidDimensions)
+        ));
+        for count in [0, 2, 5] {
+            let mut candidate = original.clone_for_append(count).unwrap();
+            assert_eq!(candidate.max_passes, 3);
+            assert!(matches!(
+                candidate.append(&j, &r, &factors, 7),
+                Err(Error::SparseFillLimit { limit: 7 })
+            ));
+            candidate.append(&j, &r, &factors, 8).unwrap();
+            let (residual, assembled) = candidate.assemble(2).unwrap();
+            assert_eq!(residual.as_slice(), &[1., -2., 1., -2.]);
+            assert_eq!(assembled.shape(), (4, 2));
+            assert_eq!(candidate.entries, 8);
+            assert_eq!(original.entries, 4);
+            assert_eq!(original.blocks.len(), 2);
+            assert!(
+                candidate
+                    .blocks
+                    .iter()
+                    .zip(&original.blocks)
+                    .all(|(a, b)| Arc::ptr_eq(a, b))
+            );
+            let (unchanged, matrix) = original.assemble(2).unwrap();
+            assert_eq!(unchanged, r);
+            assert_eq!(matrix.pattern(), j.pattern());
+            assert_eq!(matrix.values(), j.values());
+        }
+    }
