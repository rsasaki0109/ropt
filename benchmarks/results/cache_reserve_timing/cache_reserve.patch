 impl FactorCache {
+    pub fn clone_for_append(&self, count: usize) -> Result<Self, Error> {
+        let capacity = self
+            .blocks
+            .len()
+            .checked_add(count)
+            .ok_or(Error::InvalidDimensions)?;
+        // Vec::clone retains the length, not spare capacity. Reserve incoming
+        // factors before copying references so append does not grow it again.
+        let mut blocks = Vec::with_capacity(capacity);
+        blocks.extend(self.blocks.iter().cloned());
+        Ok(Self {
+            blocks,
+            entries: self.entries,
+            max_passes: self.max_passes,
+        })
+    }
     pub fn empty_like(&self) -> Self {
         Self::new(self.max_passes)
     }
