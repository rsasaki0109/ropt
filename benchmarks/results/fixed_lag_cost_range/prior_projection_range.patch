+
+fn project_retained(
+    qr: &nalgebra::linalg::QR<f64, nalgebra::Dyn, nalgebra::Dyn>,
+    mut augmented: DMatrix<f64>,
+    eliminated: usize,
+) -> DMatrix<f64> {
+    let rows = augmented.nrows();
+    let kept = rows - eliminated;
+    // A power-of-two divisor leaves headroom for dot products, doubling and
+    // updates throughout the reflection sequence. Normal scaling is exact.
+    let exponent = (usize::BITS - (rows - 1).leading_zeros()) as i32 + 3;
+    let divisor = 2.0_f64.powi(exponent);
+    let limit = f64::MAX / divisor;
+    let mut scaled = Vec::new();
+    if augmented.amax() > limit {
+        for column in 0..augmented.ncols() {
+            if augmented.column(column).amax() <= limit {
+                continue;
+            }
+            let mut tail: Option<DMatrix<f64>> = None;
+            for row in 0..rows {
+                let value = augmented[(row, column)];
+                let smaller = value / divisor;
+                if value != 0.0 && !smaller.is_normal() {
+                    // Preserve components that would lose precision or vanish
+                    // under scaling. Their independently normalized projection
+                    // is recombined only after discarding eliminated rows.
+                    tail.get_or_insert_with(|| DMatrix::zeros(rows, 1))[(row, 0)] = value;
+                    augmented[(row, column)] = 0.0;
+                } else {
+                    augmented[(row, column)] = smaller;
+                }
+            }
+            let tail = tail.map(|mut tail| {
+                let scale = tail.amax();
+                tail.iter_mut().for_each(|value| *value /= scale);
+                qr.q_tr_mul(&mut tail);
+                (tail.rows(eliminated, kept).into_owned(), scale)
+            });
+            scaled.push((column, tail));
+        }
+    }
+    qr.q_tr_mul(&mut augmented);
+    let mut retained = augmented.rows(eliminated, kept).into_owned();
+    for (column, tail) in scaled {
+        retained.column_mut(column).scale_mut(divisor);
+        if let Some((tail, scale)) = tail {
+            for row in 0..kept {
+                retained[(row, column)] += tail[(row, 0)] * scale;
+            }
+        }
+    }
+    retained
+}
