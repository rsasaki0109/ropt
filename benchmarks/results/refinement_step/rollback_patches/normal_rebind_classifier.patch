+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS:[AtomicU64;3]=[const{AtomicU64::new(0)};3];
+pub fn record(previous:Option<bool>){COUNTS[match previous {None=>0,Some(true)=>1,Some(false)=>2}].fetch_add(1,Ordering::Relaxed);}
+pub fn reset(){for c in &COUNTS{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){eprintln!("first_analysis,same_normal_pattern,changed_normal_pattern");eprintln!("{},{},{}",COUNTS[0].load(Ordering::Relaxed),COUNTS[1].load(Ordering::Relaxed),COUNTS[2].load(Ordering::Relaxed));}
