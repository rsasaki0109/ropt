+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS:[AtomicU64;14]=[const {AtomicU64::new(0)};14];
+pub fn record(values:[u64;14]) {for(c,v)in COUNTS.iter().zip(values){c.fetch_add(v,Ordering::Relaxed);}}
+pub fn reset(){for c in &COUNTS{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){for(name,c)in ["rotations","equal_width","aligned","contiguous_aligned","gapped_aligned","aligned_entries","contiguous_entries","original_index_comparisons","proposed_index_comparisons","first_mismatch","last_mismatch","interior_mismatch","single_matches","empty_matches"].iter().zip(&COUNTS){eprintln!("{name},{}",c.load(Ordering::Relaxed));}}
