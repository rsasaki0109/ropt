+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS:[AtomicU64;5]=[const {AtomicU64::new(0)};5];
+pub fn record(values:[u64;5]){for(c,v)in COUNTS.iter().zip(values){c.fetch_add(v,Ordering::Relaxed);}}
+pub fn reset(){for c in &COUNTS{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){for(name,c)in ["rotations","zero_diagonal","hits64","hits256","hits1024"].iter().zip(&COUNTS){eprintln!("{name},{}",c.load(Ordering::Relaxed));}}
