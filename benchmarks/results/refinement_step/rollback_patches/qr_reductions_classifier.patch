+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS:[AtomicU64;11]=[const {AtomicU64::new(0)};11];
+pub fn record(values:[u64;11]) {for(c,v)in COUNTS.iter().zip(values){c.fetch_add(v,Ordering::Relaxed);}}
+pub fn reset(){for c in &COUNTS{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){for(name,c)in ["rotations","aligned_rotations","aligned_entries","suffix_empty","suffix_one","suffix_two","suffix_three_to_seven","suffix_eight_to_fifteen","suffix_sixteen_to_thirtyone","suffix_thirtytwo_to_sixtythree","suffix_sixtyfour_plus"].iter().zip(&COUNTS){eprintln!("{name},{}",c.load(Ordering::Relaxed));}}
