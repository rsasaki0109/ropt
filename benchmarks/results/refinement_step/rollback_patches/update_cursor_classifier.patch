+use std::sync::atomic::{AtomicU64,Ordering};
+static TOTAL:AtomicU64=AtomicU64::new(0); static NEXT:AtomicU64=AtomicU64::new(0); static DIAG:AtomicU64=AtomicU64::new(0);
+pub fn record(next:bool,diag:bool){TOTAL.fetch_add(1,Ordering::Relaxed);NEXT.fetch_add(next as u64,Ordering::Relaxed);DIAG.fetch_add(diag as u64,Ordering::Relaxed);}
+pub fn reset(){for c in [&TOTAL,&NEXT,&DIAG]{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){eprintln!("operations,{}\nnext_entry,{}\ndiagonal,{}",TOTAL.load(Ordering::Relaxed),NEXT.load(Ordering::Relaxed),DIAG.load(Ordering::Relaxed));}
