+use std::sync::atomic::{AtomicU64,Ordering};
+static COUNTS:[AtomicU64;6]=[const {AtomicU64::new(0)};6];
+pub fn record(values:[u64;6]) { for(c,v)in COUNTS.iter().zip(values){c.fetch_add(v,Ordering::Relaxed);} }
+pub fn reset(){for c in &COUNTS{c.store(0,Ordering::Relaxed);}}
+pub fn dump(){for(name,c)in ["rotations","matched_prefix_entries","one_sided_rotations","one_sided_prefix_entries","divergent_rotations","divergent_prefix_entries"].iter().zip(&COUNTS){eprintln!("{name},{}",c.load(Ordering::Relaxed));}}
