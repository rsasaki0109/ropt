+    /// Evaluate every installed nonlinear factor at committed estimates. This
+    /// explicit probe neither changes anchors/caches nor advances the update
+    /// counter. Callbacks run again; it is not an inexpensive cached cost query.
+    /// A small gradient is a stationarity measure, not an observability certificate.
+    pub fn nonlinear_summary(
+        &self,
+        norm: crate::GradientNorm,
+    ) -> Result<IsamNonlinearSummary, Error> {
+        let (graph, ids) = build_graph(&self.variables, &self.factors, &self.order)?;
+        let (r, j) = graph.evaluate_sparse(&graph.initial())?;
+        let cost = -crate::solver::gaussian_reduction(&DVector::zeros(r.len()), &r)?;
+        let gradient = j.transpose_multiply(&r)?;
+        let mut scales = DVector::<f64>::zeros(gradient.len());
+        if norm == crate::GradientNorm::ColumnNormalized {
+            for (_, column, value) in j.entries() {
+                scales[column] = scales[column].hypot(value);
+            }
+        }
+        crate::sparse::finite_vector(&scales)?;
+        let mut components = DVector::zeros(gradient.len());
+        for (i, &value) in gradient.iter().enumerate() {
+            components[i] = if scales[i] == 0. {
+                value.abs()
+            } else {
+                value.abs() / scales[i]
+            };
+        }
+        crate::sparse::finite_vector(&components)?;
+        let mut variable_gradients = BTreeMap::new();
+        let mut gradient_norm = 0_f64;
+        for (&key, &id) in &ids {
+            if let Some(range) = graph.tangent_range(id)? {
+                let value = components.rows(range.start, range.len()).amax();
+                gradient_norm = gradient_norm.max(value);
+                variable_gradients.insert(key, value);
+            }
+        }
+        Ok(IsamNonlinearSummary {
+            cost,
+            gradient_norm,
+            norm,
+            variable_gradients,
+        })
+    }
