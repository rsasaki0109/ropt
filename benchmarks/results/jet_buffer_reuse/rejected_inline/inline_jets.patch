+#[cfg(test)]
+mod storage_tests {
+    use super::*;
+
+    #[test]
+    fn boundary_widths_preserve_vec_arithmetic_bits_and_error_precedence() {
+        for a_len in [0, 1, 2, 6, 7, 12, 32, 65] {
+            for b_len in [0, a_len, 3, 7] {
+                let a_values: Vec<_> = (0..a_len)
+                    .map(|i| match i % 4 {
+                        0 => -0.,
+                        1 => 0.,
+                        2 => 1e-150,
+                        _ => -1e150,
+                    })
+                    .collect();
+                let b_values: Vec<_> = (0..b_len)
+                    .map(|i| if i % 2 == 0 { -0. } else { 0.75 })
+                    .collect();
+                let a = DynamicJet::from_parts(0.7, Derivatives::from_fn(a_len, |i| a_values[i]));
+                let b = DynamicJet::from_parts(1.2, Derivatives::from_fn(b_len, |i| b_values[i]));
+                for (left, right) in [
+                    (1., 1.),
+                    (1., -1.),
+                    (1.2, 0.7),
+                    (-0., 0.),
+                    (1e150, -1e150),
+                    (f64::INFINITY, 0.),
+                    (f64::NAN, 1.),
+                ] {
+                    let actual = a.binary(&b, 0.8, left, right);
+                    if a_len != 0 && b_len != 0 && a_len != b_len {
+                        assert_eq!(actual.partials(), Err(Error::InvalidDimensions));
+                        continue;
+                    }
+                    // Frozen Vec implementation, including explicit zero products.
+                    let expected: Vec<_> = (0..a_len.max(b_len))
+                        .map(|i| {
+                            a_values.get(i).copied().unwrap_or(0.) * left
+                                + b_values.get(i).copied().unwrap_or(0.) * right
+                        })
+                        .collect();
+                    if expected.iter().any(|v| !v.is_finite()) {
+                        assert_eq!(actual.partials(), Err(Error::NonFinite));
+                    } else {
+                        assert_eq!(actual.value().to_bits(), 0.8_f64.to_bits());
+                        assert_eq!(
+                            actual
+                                .partials()
+                                .unwrap()
+                                .iter()
+                                .map(|v| v.to_bits())
+                                .collect::<Vec<_>>(),
+                            expected.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+                        );
+                    }
+                }
+            }
+        }
+        let invalid = DynamicJet::constant(f64::NAN);
+        let x = DynamicJet::variable(1., 0, 6).unwrap();
+        assert_eq!((&invalid + &x).partials(), Err(Error::NonFinite));
+        assert_eq!((&x + &invalid).partials(), Err(Error::NonFinite));
+    }
+
+    #[test]
+    fn cloning_equality_and_debug_preserve_public_values_across_storage_widths() {
+        for dimension in [1, 2, 6, 7, 12, 32, 65] {
+            let jet = DynamicJet::variable(2., dimension - 1, dimension).unwrap();
+            let cloned = jet.clone();
+            assert_eq!(jet, cloned);
+            let mut expected = vec![0.; dimension];
+            expected[dimension - 1] = 1.;
+            assert_eq!(
+                format!("{jet:?}"),
+                format!("DynamicJet {{ value: 2.0, derivative: {expected:?}, failure: None }}")
+            );
+            assert_eq!(cloned.partials().unwrap(), expected);
+            let negative = -&jet;
+            assert_eq!(negative.value().to_bits(), (-2_f64).to_bits());
+            for (actual, original) in negative.partials().unwrap().iter().zip(&expected) {
+                assert_eq!(actual.to_bits(), (original * -1.).to_bits());
+            }
+        }
+        assert_eq!(
+            format!("{:?}", DynamicJet::constant(3.)),
+            "DynamicJet { value: 3.0, derivative: [], failure: None }"
+        );
+    }
