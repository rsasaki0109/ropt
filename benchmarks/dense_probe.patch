 use std::{collections::BTreeMap, ops::Range};
 
+type Binding<'a> = (&'a WindowVariable, Option<Range<usize>>);
+
+/// Contiguous key spaces need one allocation and constant-time lookup. Sparse
+/// keys retain the tree; ranges still follow caller order in either layout.
+enum VariableLayout<'a> {
+    Dense {
+        first: Key,
+        bindings: Vec<Option<Binding<'a>>>,
+    },
+    Sparse(BTreeMap<Key, Binding<'a>>),
+}
+impl<'a> VariableLayout<'a> {
+    fn new(variables: &BTreeMap<Key, WindowVariable>, ordered: usize) -> Self {
+        let first = if ordered == variables.len() {
+            match (variables.first_key_value(), variables.last_key_value()) {
+                (Some((&first, _)), Some((&last, _)))
+                    if Key::try_from(ordered.saturating_sub(1)).ok() == Some(last - first) =>
+                {
+                    Some(first)
+                }
+                _ => None,
+            }
+        } else {
+            None
+        };
+        match first {
+            Some(first) => Self::Dense {
+                first,
+                bindings: vec![None; ordered],
+            },
+            None => Self::Sparse(BTreeMap::new()),
+        }
+    }
+    fn insert(&mut self, key: Key, binding: Binding<'a>) -> Result<(), Error> {
+        match self {
+            Self::Dense { first, bindings } => {
+                let index = key
+                    .checked_sub(*first)
+                    .and_then(|offset| usize::try_from(offset).ok())
+                    .ok_or(Error::InvalidDimensions)?;
+                *bindings.get_mut(index).ok_or(Error::InvalidDimensions)? = Some(binding);
+            }
+            Self::Sparse(bindings) => {
+                bindings.insert(key, binding);
+            }
+        }
+        Ok(())
+    }
+    fn get(&self, key: &Key) -> Option<&Binding<'a>> {
+        match self {
+            Self::Dense { first, bindings } => {
+                let index = usize::try_from(key.checked_sub(*first)?).ok()?;
+                bindings.get(index)?.as_ref()
+            }
+            Self::Sparse(bindings) => bindings.get(key),
+        }
+    }
+    fn visit(self, mut record: impl FnMut(Key, Binding<'a>)) {
+        match self {
+            Self::Dense { first, bindings } => {
+                for (offset, binding) in bindings.into_iter().enumerate() {
+                    if let Some(binding) = binding {
+                        // Construction proved the last key is representable.
+                        record(first + offset as Key, binding);
+                    }
+                }
+            }
+            Self::Sparse(bindings) => {
+                for (key, binding) in bindings {
+                    record(key, binding);
+                }
+            }
+        }
+    }
+}
