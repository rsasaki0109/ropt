+    #[test]
+    fn dense_offset_and_sparse_layouts_match_csr_for_nonchronological_fixed_slots() {
+        for keys in [
+            [10, 11, 12],
+            [Key::MAX - 2, Key::MAX - 1, Key::MAX],
+            [10, 12, 100],
+        ] {
+            let variables = [
+                variable(keys[0], VariableKind::Euclidean(1), &[1.], true),
+                variable(keys[1], VariableKind::Euclidean(2), &[0.5, 0.25], false),
+                variable(keys[2], VariableKind::Euclidean(1), &[0.2], false),
+            ]
+            .into_iter()
+            .map(|v| (v.key, v))
+            .collect::<BTreeMap<_, _>>();
+            let dense = keys[2] - keys[0] == 2;
+            let mut layout = VariableLayout::new(&variables, 3);
+            assert_eq!(matches!(layout, VariableLayout::Dense { .. }), dense);
+            for (&key, value) in &variables {
+                layout.insert(key, (value, None)).unwrap();
+            }
+            assert!(layout.get(&0).is_none());
+            for key in keys {
+                assert_eq!(layout.get(&key).unwrap().0.key, key);
+            }
+            let factors = vec![SmootherFactor::analytic(
+                &[keys[2], keys[0], keys[1]],
+                2,
+                FactorOptions {
+                    noise: NoiseModel::from_information(DMatrix::from_row_slice(
+                        2,
+                        2,
+                        &[4., 1., 1., 3.],
+                    ))
+                    .unwrap(),
+                    ..Default::default()
+                },
+                |v| {
+                    let (c, b, a) = (v[0][0], v[1][0], &v[2]);
+                    Ok((
+                        DVector::from_vec(vec![c + 2. * a[0] + 3. * a[1] - b, a[0] * c - 0.1]),
+                        vec![
+                            DMatrix::from_column_slice(2, 1, &[1., a[0]]),
+                            DMatrix::from_column_slice(2, 1, &[-1., 0.]),
+                            DMatrix::from_row_slice(2, 2, &[2., 3., c, 0.]),
+                        ],
+                    ))
+                },
+            )];
+            let order = [keys[2], keys[0], keys[1]];
+            for norm in [GradientNorm::Absolute, GradientNorm::ColumnNormalized] {
+                let direct = summary(&variables, &factors, &order, norm).unwrap();
+                let csr = legacy(&variables, &factors, &order, norm).unwrap();
+                assert_eq!(direct.cost.to_bits(), csr.cost.to_bits());
+                assert_eq!(direct.gradient_norm.to_bits(), csr.gradient_norm.to_bits());
+                assert_eq!(direct.variable_gradients, csr.variable_gradients);
+            }
+        }
+    }
