+        let variables = (0..3)
+            .map(|key| (key, variable(key, VariableKind::Euclidean(1), &[1.], false)))
+            .collect::<BTreeMap<_, _>>();
+        let mut dense = VariableLayout::new(&variables, 3);
+        assert!(dense.get(&1).is_none());
+        dense.insert(0, (&variables[&0], Some(0..1))).unwrap();
+        dense.insert(0, (&variables[&0], Some(1..2))).unwrap();
+        assert_eq!(dense.get(&0).unwrap().1, Some(1..2));
+        assert!(dense.get(&1).is_none());
+        assert!(dense.get(&Key::MAX).is_none());
+        assert_eq!(
+            dense.insert(Key::MAX, (&variables[&0], None)),
+            Err(Error::InvalidDimensions)
+        );
+        assert!(matches!(
+            VariableLayout::new(&variables, 2),
+            VariableLayout::Sparse(_)
+        ));
+        assert!(matches!(
+            VariableLayout::new(&BTreeMap::new(), 0),
+            VariableLayout::Sparse(_)
+        ));
